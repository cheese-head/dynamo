# 4x TP1 GPT-OSS 120B with shared-disk KVBM.
# Use with:
#   docker compose \
#     --env-file examples/kvbm/distributed/.env-distributed-disk-4x-tp1 \
#     -f examples/kvbm/distributed/docker-compose.disk-4x-tp1.yml \
#     up -d

DYNAMO_IMAGE=""

# Absolute host path to the workspace (repo root) to mount as /workspace.
# Defaults to ../../.. (relative to this compose file) if unset.
WORKSPACE_HOST_PATH=""

# Host path for the shared disk mount.
KVBM_REMOTE_DISK_HOST_PATH=""

# Mount point inside the container.
KVBM_REMOTE_DISK_CONTAINER_PATH=""

# Per-worker remote disk paths inside the container.
KVBM_REMOTE_DISK_PATHS=""

# Model settings.
MODEL=openai/gpt-oss-120b
GPU_MEMORY_UTILIZATION=0.9
ENABLE_PREFIX_CACHING=false

# GPU assignment per worker (default: 0,1,2,3).
# Override to pin workers to specific GPUs.
WORKER_0_GPU=0
WORKER_1_GPU=1
WORKER_2_GPU=2
WORKER_3_GPU=3

# HF_TOKEN is inherited from the shell if exported before docker compose.
HF_TOKEN=""

# Logging / management.
DYN_LOG=info
KVBM_DEV_MODE=TRUE

# Cache sizes.
DYN_KVBM_CPU_CACHE_GB=100

# Shared filesystem defaults.
DYN_KVBM_REMOTE_DISK_USE_GDS=0
DYN_KVBM_DISK_ZEROFILL_FALLBACK=true
DYN_KVBM_REMOTE_DISK_O_DIRECT=true

# Registry logging.
REGISTRY_LOG=dynamo_llm::block_manager::distributed::registry=info,registry=info