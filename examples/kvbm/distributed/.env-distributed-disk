# Disk-backed distributed KVBM example for a host-mounted shared filesystem.
# Use with:
#   docker compose \
#     --env-file examples/kvbm/distributed/.env-distributed-disk \
#     -f examples/kvbm/distributed/docker-compose.disk.yml \
#     up -d

DYNAMO_IMAGE=gtc-demo-vllm-local-dev:latest

# Host path for the shared Pure/NFS/GPFS appliance mount.
KVBM_REMOTE_DISK_HOST_PATH=/gpfs/gpfs0

# Mount point inside the container.
KVBM_REMOTE_DISK_CONTAINER_PATH=/mnt/pure

# vLLM / model settings.
MODEL=openai/gpt-oss-120b
TP_SIZE=8
GPU_MEMORY_UTILIZATION=0.9
ENABLE_PREFIX_CACHING=false
VLLM_EXTRA_ARGS=
HF_TOKEN=

# Logging / management.
DYN_LOG=debug
KVBM_DEV_MODE=
KVBM_MANAGEMENT_PORT=6881

# Cache sizes.
DYN_KVBM_CPU_CACHE_GB=500
DYN_KVBM_DISK_CACHE_GB=

# Shared filesystem defaults. Start with POSIX mode for network/shared filesystems.
DYN_KVBM_REMOTE_DISK_USE_GDS=0
DYN_KVBM_DISK_ZEROFILL_FALLBACK=true
DYN_KVBM_DISK_DISABLE_O_DIRECT=true

# Registry logging.
REGISTRY_LOG=dynamo_llm::block_manager::distributed::registry=debug,registry=debug
